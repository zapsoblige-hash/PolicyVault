{
  "name": "policyvault-mcp",
  "version": "1.6.2",
  "mcpName": "io.github.zapsoblige-hash/policyvault",
  "description": "PolicyVault MCP server \u2014 a thin, machine-identity-authenticated stdio adapter over the PolicyVault REST/Agent API. Zero runtime dependencies. AI MAY REQUEST; POLICYVAULT DETERMINISTICALLY DECIDES; THE COVENANT ENFORCES; SIGNERS RETAIN CUSTODY.",
  "license": "Apache-2.0",
