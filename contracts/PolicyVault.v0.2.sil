pragma silverscript ^0.1.0;

/*
 * PolicyVault v0.2
 *
 * Delegated-spending covenant vault with owner lifecycle controls.
 *
 * Immutable template constants:
 *   owner, vaultId — the root of authority and the vault identity never
 *   change for the lifetime of the lineage.
 *
 * Mutable exact live state (owner-guarded fields marked *):
 *   protectedValue, periodStartDaa, periodSpent, paused,
 *   delegate*, maxPerSpend*, periodBudget*, periodLengthDaa*,
 *   recipient1..3*, delegateActive*, policyNonce*.
 *
 * Every transition is a same-template singleton state transition: the
 * compiler-injected successor validation rebuilds the successor script
 * from this input's own template, so vaultId, covenantId and lineage are
 * preserved by construction (docs/v02-lineage-findings.md).
 *
 * Security boundary: Kaspa consensus. A malicious holder of the
 * legitimate delegate key must be unable to violate any rule below by
 * constructing transactions manually. Owner-only paths require the owner
 * signature (SIG_HASH_ALL over the full transaction).
 */
contract PolicyVault(
    pubkey owner,
    byte[32] vaultId,
    pubkey initDelegate,
    int initMaxPerSpend,
    int initPeriodBudget,
    int initPeriodLengthDaa,
    pubkey initRecipient1,
    pubkey initRecipient2,
    pubkey initRecipient3,
    int initValue,
    int initPeriodStartDaa
) {
    /* Immutable identity anchor, echoed in state for exact validation. */
    byte[32] boundVaultId = vaultId;

    /* Exact protected principal held by the covenant UTXO. */
    int protectedValue = initValue;

    /* Start of the current budget period (absolute DAA score). */
    int periodStartDaa = initPeriodStartDaa;

    /* Sompi spent by the delegate within the current period. */
    int periodSpent = 0;

    /* 0 = active, 1 = paused (owner-only). */
    int paused = 0;

    /* Delegate identity — owner-rotatable state. */
    pubkey delegate = initDelegate;

    /* Owner-migratable policy limits. */
    int maxPerSpend = initMaxPerSpend;
    int periodBudget = initPeriodBudget;
    int periodLengthDaa = initPeriodLengthDaa;

    /* Owner-migratable recipient allowlist. */
    pubkey recipient1 = initRecipient1;
    pubkey recipient2 = initRecipient2;
    pubkey recipient3 = initRecipient3;

    /* 1 = delegate may spend, 0 = revoked (owner-only). */
    int delegateActive = 1;

    /* Monotonic owner-policy version; +1 on each migratePolicy. */
    int policyNonce = 0;

    /*
     * Exact payment to an allowlisted recipient at output 0, resolved
     * against the PREVIOUS state's allowlist.
     */
    function requireAllowedPayment(
        State prevState,
        int recipientIndex,
        int payAmount
    ) {
        require(recipientIndex >= 1);
        require(recipientIndex <= 3);
        if (recipientIndex == 1) {
            require(tx.outputs[0].scriptPubKey == new ScriptPubKeyP2PK(prevState.recipient1));
        } else if (recipientIndex == 2) {
            require(tx.outputs[0].scriptPubKey == new ScriptPubKeyP2PK(prevState.recipient2));
        } else {
            require(tx.outputs[0].scriptPubKey == new ScriptPubKeyP2PK(prevState.recipient3));
        }
        require(tx.outputs[0].value == payAmount);
    }

    /* The single authorized successor carries exactly the new principal. */
    function requireExactSuccessorValue(int exactValue) {
        int successorIndex = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(tx.outputs[successorIndex].value == exactValue);
    }

    /* Identity + owner-policy fields preserved exactly (delegate paths). */
    function requirePolicyPreserved(State prevState, State newState) {
        require(newState.boundVaultId == prevState.boundVaultId);
        require(newState.delegate == prevState.delegate);
        require(newState.maxPerSpend == prevState.maxPerSpend);
        require(newState.periodBudget == prevState.periodBudget);
        require(newState.periodLengthDaa == prevState.periodLengthDaa);
        require(newState.recipient1 == prevState.recipient1);
        require(newState.recipient2 == prevState.recipient2);
        require(newState.recipient3 == prevState.recipient3);
        require(newState.delegateActive == prevState.delegateActive);
        require(newState.policyNonce == prevState.policyNonce);
    }

    /* Common invariants for every delegate spend successor. */
    function requireSpendSuccessorCore(
        State prevState,
        State newState,
        int payAmount
    ) {
        require(payAmount > 0);
        require(payAmount <= prevState.maxPerSpend);
        require(newState.protectedValue == prevState.protectedValue - payAmount);
        /* A spend may not zero the vault; closing is owner recovery. */
        require(newState.protectedValue > 0);
        require(newState.paused == 0);
        requirePolicyPreserved(prevState, newState);
    }

    /* Delegate spend within the current period. */
    #[covenant.singleton]
    function delegateSpend(
        State prevState,
        State newState,
        int payAmount,
        int recipientIndex,
        sig delegateSig
    ) {
        require(checkSig(delegateSig, prevState.delegate));
        require(prevState.delegateActive == 1);
        require(prevState.paused == 0);

        requireSpendSuccessorCore(prevState, newState, payAmount);

        require(prevState.periodSpent + payAmount <= prevState.periodBudget);
        require(newState.periodStartDaa == prevState.periodStartDaa);
        require(newState.periodSpent == prevState.periodSpent + payAmount);

        requireAllowedPayment(prevState, recipientIndex, payAmount);
        requireExactSuccessorValue(newState.protectedValue);
    }

    /*
     * Delegate spend that first advances the budget period. The CLTV time
     * proof (tx.time >= claimed new start) makes early resets impossible;
     * under-claiming periodsElapsed is allowed and budget-conservative.
     */
    #[covenant.singleton]
    function rolloverAndSpend(
        State prevState,
        State newState,
        int payAmount,
        int recipientIndex,
        int periodsElapsed,
        sig delegateSig
    ) {
        require(checkSig(delegateSig, prevState.delegate));
        require(prevState.delegateActive == 1);
        require(prevState.paused == 0);

        require(periodsElapsed >= 1);
        require(periodsElapsed <= 1000);
        int newStart = prevState.periodStartDaa + periodsElapsed * prevState.periodLengthDaa;
        require(tx.time >= newStart);

        requireSpendSuccessorCore(prevState, newState, payAmount);

        require(payAmount <= prevState.periodBudget);
        require(newState.periodStartDaa == newStart);
        require(newState.periodSpent == payAmount);

        requireAllowedPayment(prevState, recipientIndex, payAmount);
        requireExactSuccessorValue(newState.protectedValue);
    }

    /*
     * Owner lifecycle common core: principal and period accounting are
     * preserved exactly. Every owner path builds on this so no lifecycle
     * operation can move value or reset the budget accounting.
     */
    function requireOwnerLifecycleCore(State prevState, State newState) {
        require(newState.boundVaultId == prevState.boundVaultId);
        require(newState.protectedValue == prevState.protectedValue);
        require(newState.periodStartDaa == prevState.periodStartDaa);
        require(newState.periodSpent == prevState.periodSpent);
        requireExactSuccessorValue(newState.protectedValue);
    }

    /* Owner-policy fields preserved exactly (for pause/unpause). */
    function requireOwnerPolicyPreserved(State prevState, State newState) {
        require(newState.delegate == prevState.delegate);
        require(newState.maxPerSpend == prevState.maxPerSpend);
        require(newState.periodBudget == prevState.periodBudget);
        require(newState.periodLengthDaa == prevState.periodLengthDaa);
        require(newState.recipient1 == prevState.recipient1);
        require(newState.recipient2 == prevState.recipient2);
        require(newState.recipient3 == prevState.recipient3);
        require(newState.delegateActive == prevState.delegateActive);
        require(newState.policyNonce == prevState.policyNonce);
    }

    /* Owner pauses the delegate. */
    #[covenant.singleton]
    function ownerPause(
        State prevState,
        State newState,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(prevState.paused == 0);
        require(newState.paused == 1);
        requireOwnerLifecycleCore(prevState, newState);
        requireOwnerPolicyPreserved(prevState, newState);
    }

    /* Owner reactivates the delegate. */
    #[covenant.singleton]
    function ownerUnpause(
        State prevState,
        State newState,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(prevState.paused == 1);
        require(newState.paused == 0);
        requireOwnerLifecycleCore(prevState, newState);
        requireOwnerPolicyPreserved(prevState, newState);
    }

    /*
     * Owner revokes the delegate: delegateActive -> 0. The delegate key is
     * kept in state for audit continuity; the vault stays owner-usable and
     * can later be re-enabled via rotateDelegate.
     */
    #[covenant.singleton]
    function revokeDelegate(
        State prevState,
        State newState,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(prevState.delegateActive == 1);
        require(newState.delegateActive == 0);

        require(newState.paused == prevState.paused);
        require(newState.delegate == prevState.delegate);
        require(newState.maxPerSpend == prevState.maxPerSpend);
        require(newState.periodBudget == prevState.periodBudget);
        require(newState.periodLengthDaa == prevState.periodLengthDaa);
        require(newState.recipient1 == prevState.recipient1);
        require(newState.recipient2 == prevState.recipient2);
        require(newState.recipient3 == prevState.recipient3);
        require(newState.policyNonce == prevState.policyNonce);

        requireOwnerLifecycleCore(prevState, newState);
    }

    /*
     * Owner rotates the delegate key to an exact owner-selected new key and
     * (re-)enables it. Rotation NEVER resets period accounting — a rotated
     * delegate inherits the current periodSpent and periodStartDaa, so key
     * rotation cannot grant a fresh budget. Also serves as the
     * re-enable-after-revoke path.
     */
    #[covenant.singleton]
    function rotateDelegate(
        State prevState,
        State newState,
        pubkey newDelegate,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(newState.delegate == newDelegate);
        require(newState.delegateActive == 1);

        require(newState.paused == prevState.paused);
        require(newState.maxPerSpend == prevState.maxPerSpend);
        require(newState.periodBudget == prevState.periodBudget);
        require(newState.periodLengthDaa == prevState.periodLengthDaa);
        require(newState.recipient1 == prevState.recipient1);
        require(newState.recipient2 == prevState.recipient2);
        require(newState.recipient3 == prevState.recipient3);
        require(newState.policyNonce == prevState.policyNonce);

        requireOwnerLifecycleCore(prevState, newState);
    }

    /*
     * Owner top-up: protected principal strictly increases; the successor
     * output carries exactly the new principal (funded by ordinary owner
     * inputs — the covenant input value plus external funding). Nothing
     * else changes: policy, accounting, pause and delegate status are all
     * preserved, so a top-up can never smuggle a policy change or an
     * accounting reset.
     */
    #[covenant.singleton]
    function ownerTopUp(
        State prevState,
        State newState,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(newState.protectedValue > prevState.protectedValue);

        require(newState.boundVaultId == prevState.boundVaultId);
        require(newState.periodStartDaa == prevState.periodStartDaa);
        require(newState.periodSpent == prevState.periodSpent);
        require(newState.paused == prevState.paused);
        requireOwnerPolicyPreserved(prevState, newState);

        requireExactSuccessorValue(newState.protectedValue);
    }

    /*
     * Owner policy migration: limits, period length and the allowlist may
     * change; policyNonce increments by exactly 1. Principal, period
     * accounting, delegate identity/status and pause status are preserved —
     * a policy change never silently resets the current period's budget.
     * If the new periodBudget is below periodSpent, delegate spending stays
     * blocked until a valid rollover.
     */
    #[covenant.singleton]
    function migratePolicy(
        State prevState,
        State newState,
        sig ownerSig
    ) {
        require(checkSig(ownerSig, owner));
        require(newState.maxPerSpend > 0);
        require(newState.periodBudget > 0);
        require(newState.periodLengthDaa > 0);
        require(newState.policyNonce == prevState.policyNonce + 1);

        require(newState.paused == prevState.paused);
        require(newState.delegate == prevState.delegate);
        require(newState.delegateActive == prevState.delegateActive);

        requireOwnerLifecycleCore(prevState, newState);
    }

    /*
     * Owner recovery. Terminal: the lineage ends and the full remaining
     * principal moves to the owner key at output 0. Unconditional with
     * owner authority regardless of pause/revocation status.
     */
    #[covenant.singleton(
        mode = transition,
        termination = allowed
    )]
    function ownerRecover(
        State prevState,
        State[] nextStates,
        sig ownerSig
    ) : (State[]) {
        require(checkSig(ownerSig, owner));
        require(nextStates.length == 0);
        require(tx.outputs[0].scriptPubKey == new ScriptPubKeyP2PK(owner));
        require(tx.outputs[0].value == prevState.protectedValue);
        return(nextStates);
    }
}
