# PolicyVault PRODUCTION environment — TEMPLATE ONLY (runbook §12).
#
# Copy to /opt/policyvault/prod.env on the production app host, owned
# root:root mode 600. NEVER commit the filled file (deploy/*.env is
# gitignored). NEVER put wallet keys or seed phrases anywhere in
# deployment configuration — SERVER WALLET CUSTODY = NONE (runbook §9):
# no wallet secret of any role exists as a hosted secret, by design.
#
# Every value below is part of the fail-closed hosted-mainnet enablement
# matrix (runbook §12): missing dual unlock or RPC URL THROWS at
# loadConfig; a staging banner or dev flag REFUSES on mainnet; a
# wrong-network database refuses via the write-once network stamp.

# ---- network (hosted production is MAINNET, explicitly) ----
KASPA_NETWORK_ID=mainnet
# Dual unlock: mainnet requires BOTH this flag and the explicit RPC URL.
POLICYVAULT_ALLOW_MAINNET=true
# The PRIVATE transport address of the trusted mainnet kaspad
# (Option A: WireGuard peer, e.g. ws://10.88.0.2:18110, or the
# host-terminated forward ws://host-kaspad:18110). NEVER a public node.
KASPA_RPC_URL=ws://REPLACE-PRIVATE-TRANSPORT-ADDRESS:18110

# ---- build identity (non-secret; the authorized release) ----
# MUST equal the buildId of the authorized image (§10.8 triple);
# /health surfaces it and Level 1 smoke asserts it.
POLICYVAULT_BUILD_ID=REPLACE_WITH_AUTHORIZED_BUILD_ID
PV_PROD_APP_TAG=REPLACE_WITH_AUTHORIZED_RELEASE_TAG

# ---- pinned images ----
PV_PROD_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2

# ---- hosted persistence (DO Managed PostgreSQL, VPC-private, TLS) ----
POLICYVAULT_PERSISTENCE=postgres
POLICYVAULT_PG_HOST=REPLACE-WITH-PRIVATE-DB-HOSTNAME
POLICYVAULT_PG_PORT=25060
POLICYVAULT_PG_USER=pvprod
POLICYVAULT_PG_PASSWORD=REPLACE_FROM_DO_DASHBOARD
POLICYVAULT_PG_DATABASE=policyvault_prod
# POLICYVAULT_PG_NO_TLS must NOT be set in production (testnet-only
# concession; mainnet config treats it as a misconfiguration).
# DO Managed PG uses a per-cluster private CA; the store verifies TLS
# strictly (rejectUnauthorized: true), so the cluster CA must be trusted
# via Node's additive CA mechanism (cert mounted read-only by compose):
NODE_EXTRA_CA_CERTS=/app/pg-ca.crt

# ---- hosted authentication + request protection ----
POLICYVAULT_HOSTED_AUTH=1
POLICYVAULT_APP_ORIGIN=https://app.policy-vault.org
# Sound ONLY because the origin is unreachable except through the
# Cloudflare Tunnel (spoofed header refused at the edge — §4.3).
POLICYVAULT_TRUSTED_PROXY_HEADER=cf-connecting-ip

# ---- explicitly ABSENT by requirement (runbook §12) ----
# POLICYVAULT_STAGING_BANNER   — mainnet REFUSES it
# POLICYVAULT_PG_NO_TLS        — testnet-only concession
# POLICYVAULT_HOSTED_DEV_OPEN  — never
# POLICYVAULT_DEV_SIGNER       — mainnet startup refuses dev signer
# POLICYVAULT_LEGACY_CREATE    — mainnet startup refuses legacy create
# PV_TEST_CRASH_AT             — never
#
# ---- explicitly ABSENT here: not yet promoted (mobile lane, TRACK B) ----
# POLICYVAULT_AUTH_BEARER_SESSIONS — mobile session-bootstrap DESIGN
#   FREEZE §2 (mobile/docs/session-bootstrap-DESIGN.md): a config-gated
#   bearer wallet-session sibling of the cookie session, for the
#   Capacitor mobile client. Default OFF (absent, or any value other
#   than the exact string "1", is off — sdk/src/config.js). This is
#   deliberately code + tests only right now: production enablement is
#   its own separate, explicit future release decision, not implied by
#   this flag existing. Do not set it here without that decision.
