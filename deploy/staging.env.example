# PolicyVault TESTNET-10 STAGING environment — TEMPLATE ONLY.
#
# Copy to deploy/staging.env (gitignored) and fill in the placeholders.
# NEVER commit deploy/staging.env. NEVER put wallet keys or seed phrases
# anywhere in deployment configuration — the application must not possess
# them (they do not exist as hosted secrets, by design).

# ---- network (STAGING IS TESTNET-10 ONLY; mainnet must be impossible) ----
KASPA_NETWORK_ID=testnet-10
# The host-side private kaspad forwarder (tools/staging-kaspad-proxy.js).
KASPA_RPC_URL=ws://host-kaspad:18210
POLICYVAULT_STAGING_BANNER=1

# ---- build identity (non-secret; git short SHA of the build) ----
POLICYVAULT_BUILD_ID=REPLACE_WITH_GIT_SHORT_SHA
PV_STAGING_APP_TAG=staging

# ---- pinned images (record the resolved digests in the evidence) ----
PV_STAGING_POSTGRES_IMAGE=postgres:16-alpine
PV_STAGING_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2

# ---- hosted persistence (PostgreSQL on the compose-private network) ----
POLICYVAULT_PERSISTENCE=postgres
POLICYVAULT_PG_HOST=postgres
POLICYVAULT_PG_PORT=5432
POLICYVAULT_PG_USER=pvstaging
POLICYVAULT_PG_PASSWORD=REPLACE_WITH_RANDOM_STAGING_ONLY_PASSWORD
POLICYVAULT_PG_DATABASE=policyvault_staging
# Compose-network PG has no TLS certificates; the no-TLS override is
# permitted on testnet only. Production (managed PG) uses TLS — this
# divergence is a documented staging-only concession.
POLICYVAULT_PG_NO_TLS=1
# compose-level duplicates for the postgres container itself:
PV_STAGING_PG_USER=pvstaging
PV_STAGING_PG_PASSWORD=REPLACE_WITH_RANDOM_STAGING_ONLY_PASSWORD
PV_STAGING_PG_DATABASE=policyvault_staging

# ---- hosted authentication + request protection ----
POLICYVAULT_HOSTED_AUTH=1
# The EXTERNAL application origin (the Cloudflare Quick Tunnel URL —
# read it from the cloudflared service logs, then restart app):
POLICYVAULT_APP_ORIGIN=https://REPLACE-WITH-ASSIGNED-NAME.trycloudflare.com
# Behind the Tunnel, the client IP arrives in cf-connecting-ip; the
# origin is not directly reachable, so the header is trustworthy.
POLICYVAULT_TRUSTED_PROXY_HEADER=cf-connecting-ip

# ---- explicitly NOT set (mainnet must be impossible in staging) ----
# POLICYVAULT_ALLOW_MAINNET  — never
# POLICYVAULT_DEV_SIGNER     — never in an externally reachable service
# POLICYVAULT_LEGACY_CREATE  — never
# PV_TEST_CRASH_AT           — never
